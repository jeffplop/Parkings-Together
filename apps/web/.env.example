# ==========================================
# Plantilla de variables de entorno — apps/web
# Copiar a .env.local (NUNCA commitear .env.local) y rellenar con valores reales.
# En Vercel, definir estas mismas variables en:
#   Project Settings → Environment Variables (scope: Production + Preview)
# ==========================================

# --- Supabase (públicas, expuestas al navegador) ---
NEXT_PUBLIC_SUPABASE_URL="https://<tu-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-jwt>"

# --- Supabase (privada, SOLO servidor — NUNCA exponer ni commitear) ---
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Google Gemini (privada, SOLO servidor — NUNCA exponer ni commitear) ---
# Opcional. Habilita las funciones de IA: resumen de reseñas (/api/resenas/resumen)
# y sugeridor de precios (/api/precios/sugerencia). Sin ella, esas funciones se
# degradan con elegancia (no rompen la app). Obtener en: https://aistudio.google.com/
# Se acepta también GOOGLE_API_KEY como alias.
GEMINI_API_KEY=""
# GEMINI_MODEL=""   # opcional: forzar un modelo; por defecto se autodescubre uno 'flash'

# --- Mapa (Leaflet) — opcional -----------------------------------------------
# Por defecto se usa Esri World Dark Gray Base: mapa oscuro, SIN API key y sin
# marca de agua. Definir estas variables solo si se quiere otro proveedor (p. ej.
# CARTO con key). CARTO sin key muestra "API KEY REQUIRED" sobre el mapa.
# NEXT_PUBLIC_MAP_TILES_URL="https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}"
# NEXT_PUBLIC_MAP_TILES_ATTRIBUTION="Tiles &copy; Esri"

# --- Webpay Plus (Transbank) — opcional --------------------------------------
# Sin estas variables se usa el ambiente de INTEGRACIÓN con credenciales públicas
# de prueba (no mueve dinero real). Para producción, credenciales de tu comercio.
# TBK_ENV="integration"          # "integration" | "production"
# TBK_COMMERCE_CODE=""
# TBK_API_KEY=""

# --- Microservicios (opcionales; el web usa route handlers de mismo origen) ---
# NEXT_PUBLIC_MS_MAPAS_URL="https://<ms-mapas>.vercel.app/api/v1"
# NEXT_PUBLIC_MS_RESERVAS_URL="https://<ms-reservas>.vercel.app/api/v1"
# NEXT_PUBLIC_MS_AUTH_URL="https://<ms-auth>.vercel.app/api/v1"
